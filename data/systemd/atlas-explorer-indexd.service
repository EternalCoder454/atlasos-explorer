[Unit]
Description=Atlas Explorer file index
Documentation=https://github.com/EternalCoder454/atlasos-explorer

# Not started at login: the first query on net.eterneon.atlas.explorer.Search
# starts it (D-Bus activation), and it stays to keep its inotify watches.
[Service]
Type=dbus
BusName=net.eterneon.atlas.explorer.Search
ExecStart=/usr/bin/atlas-explorer-indexd
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
MemoryHigh=96M
# Hard ceiling: 4M records (the index limit) are about 400 MB, and a rebuild
# or a snapshot write briefly holds a second copy.
MemoryMax=1G
# One thread per running search (at most 8), the worker, the snapshot writer,
# the bus and a few spare.
TasksMax=128
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s

# The cache folder is made (0700) and is the only place it can write; the
# service reads it from $CACHE_DIRECTORY.
CacheDirectory=atlas-explorer
CacheDirectoryMode=0700
# It reads the user's files and the settings, and writes only its cache.
# ProcSubset=pid is not set: it reads /proc/sys/fs/inotify/max_user_watches.
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Not ~@resources: setpriority and ioprio_set (the scanner's low priority)
# are in it. A refused call fails with EPERM instead of killing the service.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
